# =========================================================================
# Village Setu / Cybercafe Database Management System — .env.example
# =========================================================================
# Copy this file to `.env` (local dev) or set the same variables in the
# Vercel project settings (Project → Settings → Environment Variables).
# NEVER commit the real `.env` file to GitHub.
# -------------------------------------------------------------------------

# --- Database (REQUIRED) -------------------------------------------------
# Use a MySQL-compatible cloud DB. Examples:
#
#   TiDB Serverless (free tier, recommended):
#     mysql+pymysql://<user>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<db>?ssl_ca=/etc/ssl/cert.pem&ssl_verify_cert=true
#
#   Aiven MySQL:
#     mysql+pymysql://<user>:<password>@<host>:<port>/<db>?ssl_ca=/path/to/ca.pem
#
#   Railway MySQL:
#     mysql+pymysql://<user>:<password>@<host>:<port>/<db>
#
#   PlanetScale (note: PlanetScale deprecated their free plan in 2024):
#     mysql+pymysql://<user>:<password>@<host>:3306/<db>
#
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/village_setu

# --- Auth / JWT ----------------------------------------------------------
# Generate a long random string for production. Example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Bootstrap admin -----------------------------------------------------
# These credentials create the first admin user on first run.
ADMIN_EMAIL=admin@villagesetu.gov.in
ADMIN_PASSWORD=Admin@12345

# --- File uploads --------------------------------------------------------
# On Vercel, files are stored as base64 inside the database, so this folder
# is only used for local dev. Max single-file size in MB.
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=5

# --- Aadhaar encryption key (REQUIRED for production) --------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-this-with-a-real-44-char-fernet-key==

# --- CORS ----------------------------------------------------------------
# Comma-separated origins, or "*" for any.
CORS_ORIGINS=*

# --- App meta ------------------------------------------------------------
APP_NAME=Village Setu
APP_ENV=production
