# =========================================================================
# Village Setu / Cybercafe Database Management System — .env.example
# =========================================================================
# Copy this file to `.env` (local dev) or set the same variables in the
# Vercel project settings (Project → Settings → Environment Variables).
# NEVER commit the real `.env` file to GitHub.
# -------------------------------------------------------------------------

# --- Database (REQUIRED) -------------------------------------------------
# PostgreSQL (any cloud provider). Examples:
#
#   Aiven for PostgreSQL (recommended — what we tested with):
#     postgresql+psycopg2://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require
#
#   Neon:
#     postgresql+psycopg2://<user>:<password>@<host>/<db>?sslmode=require
#
#   Supabase:
#     postgresql+psycopg2://postgres:<password>@<host>:5432/postgres
#
#   Railway:
#     postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
#
# NOTE: The connection string from Aiven's "psql" tab uses the
# `postgres://` scheme — change it to `postgresql+psycopg2://` for SQLAlchemy.
DATABASE_URL=postgresql+psycopg2://avnadmin:PASSWORD@pg-XXX-XXX-XXX.aivencloud.com:27478/defaultdb?sslmode=require

# --- Auth / JWT ----------------------------------------------------------
# Generate a long random string for production. Example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Bootstrap admin -----------------------------------------------------
# These credentials create the first admin user on first run.
ADMIN_EMAIL=admin@villagesetu.gov.in
ADMIN_PASSWORD=Admin@12345

# --- File uploads --------------------------------------------------------
# On Vercel, files are stored as base64 inside the database, so this folder
# is only used for local dev. Max single-file size in MB.
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=5

# --- Aadhaar encryption key (REQUIRED for production) --------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-this-with-a-real-44-char-fernet-key==

# --- CORS ----------------------------------------------------------------
# Comma-separated origins, or "*" for any.
CORS_ORIGINS=*

# --- App meta ------------------------------------------------------------
APP_NAME=Village Setu
APP_ENV=production
