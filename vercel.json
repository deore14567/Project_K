{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pip install -r requirements.txt",
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "backend/**",
        "maxLambdaSize": "50mb",
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/main.py" },
    { "src": "/css/(.*)", "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)",  "dest": "/frontend/js/$1"  },
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/(.*\\.html)", "dest": "/frontend/$1" },
    { "src": "/favicon.ico", "dest": "/frontend/assets/favicon.ico" },
    { "src": "/health", "dest": "backend/main.py" },
    { "src": "/(.*)", "dest": "backend/main.py" }
  ]
}
